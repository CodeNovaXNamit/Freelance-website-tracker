rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the document belongs to the user
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper to ensure userId is correctly set on create
    function isCreatingOwn(userId) {
      return request.resource.data.userId == userId;
    }

    // Helper to ensure userId cannot be changed on update
    function isNotChangingOwner() {
      return request.resource.data.userId == resource.data.userId;
    }

    // All documents are nested under /users/{userId}/{collectionName}/{documentId}
    match /users/{userId}/{collectionName}/{documentId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId) && isCreatingOwn(userId);
      allow update: if isAuthenticated() && isOwner(userId) && isNotChangingOwner();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
  }
}
